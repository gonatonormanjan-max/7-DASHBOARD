DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/NORTHSTAR_INVENTORY"

# AUTH_SECRET — the signing key for JWT session tokens.
# Generate a secure value with: openssl rand -base64 32
# ROTATION PROCEDURE (when you need to change this key):
#   1. Generate a new secret (command above).
#   2. Update this value in your production environment.
#   3. Restart the server — all existing sessions are immediately invalidated.
#   4. Users will be redirected to /auth/login cleanly (no redirect loop,
#      because the proxy now validates JWT integrity, not just cookie presence).
#   5. No database changes needed; the LoginRateLimitBucket table is unaffected.
AUTH_SECRET="replace-with-a-long-random-secret"

# Auth session duration in seconds. Default is 43200 (12 hours) when omitted
# or invalid. Keep this server-only; do not prefix it with NEXT_PUBLIC_.
AUTH_SESSION_MAX_AGE_SECONDS="43200"

NEXT_PUBLIC_CURRENCY_LOCALE="en-PH"
NEXT_PUBLIC_CURRENCY_CODE="PHP"

# BUSINESS_TIMEZONE is baked into lib/timezone.ts as "Asia/Manila".
# If you ever deploy in a different region, update the constant there directly
# rather than using an env var — timezone logic requires a code change + test cycle.
# Reports PDF export is intentionally disabled by default while under hardening.
# Set to "1" only when you explicitly want to enable the feature.
ENABLE_REPORTS_PDF_EXPORT="0"

# Required only when uploading product photos to Vercel Blob.
# Add this in Vercel Preview/Production env vars and pull it locally when testing uploads.
BLOB_READ_WRITE_TOKEN="vercel-blob-read-write-token"
