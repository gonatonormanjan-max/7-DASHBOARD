generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SYSTEM_MANAGER
  MANAGER
  SALES_STAFF
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum SalesOrderVoidReason {
  DEFECT
  RETURNED_REFUND
  REPLACE
  OTHERS
}

enum PaymentMode {
  CASH
  ONLINE
  MIXED
}

enum LocationType {
  WAREHOUSE
  BRANCH
}

enum MovementType {
  PURCHASE_RECEIVED
  SALES_FULFILLED
  MANUAL_ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  DISMANTLE_OUT
  DISMANTLE_IN
  CUSTOMER_RETURN
  DAMAGED_LOST
  INITIAL_STOCK
}

enum AdjustmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StockCountType {
  OPENING
  CLOSING
}

enum StockCountStatus {
  DRAFT
  SUBMITTED
}

enum IssueReportStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum VaultTransactionType {
  SALE
  VOID_REVERSAL
  CASH_DROP
  OPENING_FLOAT
  MANUAL_ADJUSTMENT
}

enum VaultPaymentMethod {
  CASH
  ONLINE
}

enum CashDropDestination {
  SAFE
  BANK_DEPOSIT
  HANDED_TO_ADMIN
  OTHERS
}

model User {
  id                         String                 @id @default(uuid())
  firstName                  String
  lastName                   String
  email                      String                 @unique
  hashedPassword             String
  role                       Role                   @default(SALES_STAFF)
  isActive                   Boolean                @default(true)
  assignedLocationId         String?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  assignedLocation           StockLocation?         @relation(fields: [assignedLocationId], references: [id], onDelete: SetNull)
  accounts                   Account[]
  createdPurchaseOrders      PurchaseOrder[]        @relation("PurchaseOrderCreatedBy")
  approvedPurchaseOrders     PurchaseOrder[]        @relation("PurchaseOrderApprovedBy")
  createdSalesOrders         SalesOrder[]           @relation("SalesOrderCreatedBy")
  voidedSalesOrders          SalesOrder[]           @relation("SalesOrderVoidedBy")
  inventoryMovements         InventoryMovement[]
  auditLogs                  AuditLog[]
  productCostHistory         ProductCostHistory[]
  adjustmentRequestsMade     AdjustmentRequest[]    @relation("AdjustmentRequestedBy")
  adjustmentRequestsReviewed AdjustmentRequest[]    @relation("AdjustmentReviewedBy")
  dismantleRecords           DismantleRecord[]
  stockCounts                StockCount[]
  issueReportsSubmitted      IssueReport[]          @relation("IssueSubmittedBy")
  issueReportsAcknowledged   IssueReport[]          @relation("IssueAcknowledgedBy")
  issueReportsResolved       IssueReport[]          @relation("IssueResolvedBy")
  changeFundAllocations      ChangeFundAllocation[]
  vaultTransactions          VaultTransaction[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Supplier {
  id             String            @id @default(uuid())
  name           String            @unique
  contactName    String?
  email          String?
  phone          String?
  address        String?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  productLinks   ProductSupplier[]
  purchaseOrders PurchaseOrder[]
}

model ProductSupplier {
  id           String   @id @default(uuid())
  productId    String
  supplierId   String
  isPrimary    Boolean  @default(false)
  costPrice    Decimal  @db.Decimal(12, 2)
  leadTimeDays Int?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@unique([productId, supplierId])
  @@index([supplierId])
}

model Product {
  id                 String                 @id @default(uuid())
  name               String
  sku                String                 @unique
  description        String?
  unitPrice          Decimal                @db.Decimal(12, 2)
  costPrice          Decimal                @db.Decimal(12, 2)
  reorderLevel       Int                    @default(0)
  imageUrl           String?
  status             ProductStatus          @default(ACTIVE)
  categoryId         String
  brandId            String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  category           Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand              Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  suppliers          ProductSupplier[]
  locationStock      LocationStock[]
  locationCosts      LocationProductCost[]
  locationPrices     LocationProductPrice[]
  costHistory        ProductCostHistory[]
  purchaseItems      PurchaseOrderItem[]
  salesItems         SalesOrderItem[]
  movements          InventoryMovement[]
  adjustmentRequests AdjustmentRequest[]
  kitComponents      ProductKitComponent[]  @relation("KitComponents")
  usedInKits         ProductKitComponent[]  @relation("UsedInKits")
  dismantleRecords   DismantleRecord[]
  stockCountLines    StockCountLine[]

  @@index([name])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
}

model ProductKitComponent {
  id                 String  @id @default(uuid())
  kitProductId       String
  componentProductId String
  componentQty       Int     @default(1)
  kitProduct         Product @relation("KitComponents", fields: [kitProductId], references: [id], onDelete: Cascade)
  componentProduct   Product @relation("UsedInKits", fields: [componentProductId], references: [id], onDelete: Restrict)

  @@unique([kitProductId, componentProductId])
  @@index([componentProductId])
}

model StockLocation {
  id                   String                 @id @default(uuid())
  name                 String                 @unique
  code                 String                 @unique
  type                 LocationType
  address              String?
  managerName          String?
  contactNumber        String?
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  assignedUsers        User[]
  stock                LocationStock[]
  productCosts         LocationProductCost[]
  costHistory          ProductCostHistory[]
  quotaSetting         BranchQuotaSetting?
  salesOrders          SalesOrder[]           @relation("SalesOrderLocation")
  salesItems           SalesOrderItem[]
  movements            InventoryMovement[]
  adjustmentRequests   AdjustmentRequest[]
  dismantleRecords     DismantleRecord[]
  stockCounts          StockCount[]
  issueReports         IssueReport[]
  changeFundAllocation ChangeFundAllocation?
  locationPrices       LocationProductPrice[]
  vault                BranchVault?
  vaultTransactions    VaultTransaction[]
}

model BranchQuotaSetting {
  id                String        @id @default(uuid())
  branchId          String        @unique
  rollingWindowDays Int           @default(30)
  revenueTarget     Decimal?      @db.Decimal(12, 2)
  unitsTarget       Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  branch            StockLocation @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
}

// Stores per-branch selling price overrides for products.
// When a row exists for a (locationId, productId) pair, that price is used
// instead of the product's global unitPrice for sales at that branch.
// Fallback: if no row exists, the product's global unitPrice applies.
model LocationProductPrice {
  id         String        @id @default(uuid())
  locationId String
  productId  String
  price      Decimal       @db.Decimal(12, 2)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  location   StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([locationId, productId])
  @@index([productId])
}

model LocationStock {
  id           String        @id @default(uuid())
  locationId   String
  productId    String
  quantity     Int           @default(0)
  reservedQty  Int           @default(0)
  reorderLevel Int?
  updatedAt    DateTime      @updatedAt
  location     StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([locationId, productId])
  @@index([productId])
}

model DismantleRecord {
  id             String        @id @default(uuid())
  locationId     String
  kitProductId   String
  qty            Int
  notes          String?
  dismantledById String
  createdAt      DateTime      @default(now())
  location       StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  kitProduct     Product       @relation(fields: [kitProductId], references: [id], onDelete: Restrict)
  dismantledBy   User          @relation(fields: [dismantledById], references: [id], onDelete: Restrict)

  @@index([locationId])
  @@index([kitProductId])
}

model AdjustmentRequest {
  id            String                  @id @default(uuid())
  branchId      String
  productId     String
  direction     String // "increase" | "decrease"
  quantity      Int
  reason        String
  notes         String?
  status        AdjustmentRequestStatus @default(PENDING)
  requestedById String
  requestedAt   DateTime                @default(now())
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNotes   String?
  branch        StockLocation           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product       Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  requestedBy   User                    @relation("AdjustmentRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy    User?                   @relation("AdjustmentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([productId])
  @@index([requestedById])
  @@index([status])
}

model StockCount {
  id            String           @id @default(uuid())
  locationId    String
  type          StockCountType
  countDate     DateTime         @db.Date
  status        StockCountStatus @default(DRAFT)
  submittedById String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  location      StockLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  submittedBy   User             @relation(fields: [submittedById], references: [id], onDelete: Restrict)
  lines         StockCountLine[]

  @@unique([locationId, type, countDate])
  @@index([locationId])
}

model StockCountLine {
  id           String     @id @default(uuid())
  stockCountId String
  productId    String
  systemQty    Int
  countedQty   Int
  notes        String?
  stockCount   StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, productId])
  @@index([productId])
}

model IssueReport {
  id               String            @id @default(uuid())
  branchId         String
  title            String
  body             String
  status           IssueReportStatus @default(OPEN)
  submittedById    String
  acknowledgedById String?
  resolvedById     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  branch           StockLocation     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  submittedBy      User              @relation("IssueSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  acknowledgedBy   User?             @relation("IssueAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  resolvedBy       User?             @relation("IssueResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([status])
}

model ChangeFundAllocation {
  id        String        @id @default(uuid())
  branchId  String        @unique
  amount    Decimal       @db.Decimal(12, 2)
  setById   String
  notes     String?
  updatedAt DateTime      @updatedAt
  branch    StockLocation @relation(fields: [branchId], references: [id], onDelete: Cascade)
  setBy     User          @relation(fields: [setById], references: [id], onDelete: Restrict)
}

model LocationProductCost {
  id                  String        @id @default(uuid())
  locationId          String
  productId           String
  avgUnitCost         Decimal       @db.Decimal(12, 2)
  lastInboundUnitCost Decimal?      @db.Decimal(12, 2)
  onHandQtySnapshot   Int           @default(0)
  updatedAt           DateTime      @updatedAt
  location            StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product             Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([locationId, productId])
  @@index([productId])
}

model ProductCostHistory {
  id              String        @id @default(uuid())
  locationId      String
  productId       String
  inboundQty      Int
  inboundUnitCost Decimal       @db.Decimal(12, 2)
  prevAvgUnitCost Decimal       @db.Decimal(12, 2)
  newAvgUnitCost  Decimal       @db.Decimal(12, 2)
  sourceType      String
  sourceId        String?
  changePct       Decimal?      @db.Decimal(7, 4)
  reason          String?
  changedById     String
  createdAt       DateTime      @default(now())
  location        StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  changedBy       User          @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([locationId, productId, createdAt])
  @@index([productId, createdAt])
  @@index([changedById, createdAt])
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  orderNumber  String              @unique
  supplierId   String
  status       PurchaseOrderStatus @default(DRAFT)
  totalAmount  Decimal             @db.Decimal(12, 2)
  expectedDate DateTime?
  notes        String?
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy    User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy   User?               @relation("PurchaseOrderApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  items        PurchaseOrderItem[]

  @@index([status])
  @@index([supplierId])
  @@index([createdById])
  @@index([approvedById])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  receivedQty     Int           @default(0)
  unitCost        Decimal       @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, productId])
}

model SalesOrder {
  id                String                @id @default(uuid())
  orderNumber       String                @unique
  customerName      String
  customerEmail     String?
  locationId        String?
  status            SalesOrderStatus      @default(DRAFT)
  totalAmount       Decimal               @db.Decimal(12, 2)
  paymentMode       PaymentMode?
  cashAmount        Decimal?              @db.Decimal(12, 2)
  onlineAmount      Decimal?              @db.Decimal(12, 2)
  notes             String?
  archivedAt        DateTime?
  voidReason        SalesOrderVoidReason?
  voidRemarks       String?
  voidDocumentation String?
  voidedAt          DateTime?
  createdById       String
  voidedById        String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  location          StockLocation?        @relation("SalesOrderLocation", fields: [locationId], references: [id], onDelete: SetNull)
  createdBy         User                  @relation("SalesOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy          User?                 @relation("SalesOrderVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  items             SalesOrderItem[]

  @@index([status])
  @@index([locationId])
  @@index([createdById])
  @@index([voidedById])
  @@index([voidReason])
  @@index([archivedAt])
}

model SalesOrderItem {
  id              String        @id @default(uuid())
  salesOrderId    String
  productId       String
  locationId      String
  quantity        Int
  unitPrice       Decimal       @db.Decimal(12, 2)
  unitCostAtSale  Decimal       @default(0) @db.Decimal(12, 2)
  lineCogs        Decimal       @default(0) @db.Decimal(12, 2)
  lineGrossProfit Decimal       @default(0) @db.Decimal(12, 2)
  isEstimatedCost Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  salesOrder      SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  location        StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([locationId])
}

model InventoryMovement {
  id              String        @id @default(uuid())
  type            MovementType
  productId       String
  locationId      String
  quantityChange  Int
  transferGroupId String?
  referenceType   String?
  referenceId     String?
  notes           String?
  performedById   String
  createdAt       DateTime      @default(now())
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  location        StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  performedBy     User          @relation(fields: [performedById], references: [id], onDelete: Restrict)

  @@index([productId, locationId, createdAt])
  @@index([referenceType, referenceId])
  @@index([performedById])
  @@index([transferGroupId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  details   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entity, entityId])
  @@index([userId, createdAt])
}

model LoginRateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// Per-branch running balance for cash and online payments.
// Denormalized cache — source of truth is VaultTransaction.
// Always updated atomically inside the same $transaction that inserts
// a VaultTransaction row.
model BranchVault {
  id            String        @id @default(uuid())
  branchId      String        @unique
  cashBalance   Decimal       @default(0) @db.Decimal(12, 2)
  onlineBalance Decimal       @default(0) @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())
  lastUpdatedAt DateTime      @updatedAt
  branch        StockLocation @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
}

// Immutable append-only ledger for every event that changes a BranchVault.
// One row per payment method affected per event (a split sale creates two rows).
// Signed amount: positive = credit to the branch, negative = debit.
// Unique (referenceType, referenceId, type, paymentMethod) prevents duplicate
// credits from retries or replayed transactions.
model VaultTransaction {
  id                  String               @id @default(uuid())
  branchId            String
  type                VaultTransactionType
  paymentMethod       VaultPaymentMethod
  amount              Decimal              @db.Decimal(12, 2)
  referenceType       String?
  referenceId         String?
  cashDropDestination CashDropDestination?
  destinationNote     String?
  notes               String?
  performedById       String
  createdAt           DateTime             @default(now())
  branch              StockLocation        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  performedBy         User                 @relation(fields: [performedById], references: [id], onDelete: Restrict)

  @@unique([referenceType, referenceId, type, paymentMethod])
  @@index([branchId, createdAt])
  @@index([type, createdAt])
  @@index([performedById])
}
