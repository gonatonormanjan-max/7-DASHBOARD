generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SYSTEM_MANAGER
  SALES_STAFF
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum SalesOrderVoidReason {
  DEFECT
  RETURNED_REFUND
  REPLACE
  OTHERS
}

enum PaymentMode {
  CASH
  ONLINE
  MIXED
}

enum LocationType {
  WAREHOUSE
  BRANCH
}

enum MovementType {
  PURCHASE_RECEIVED
  SALES_FULFILLED
  MANUAL_ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  CUSTOMER_RETURN
  DAMAGED_LOST
  INITIAL_STOCK
}

model User {
  id                      String               @id @default(uuid())
  firstName               String
  lastName                String
  email                   String               @unique
  hashedPassword          String
  role                    Role                 @default(SALES_STAFF)
  isActive                Boolean              @default(true)
  assignedLocationId      String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  assignedLocation        StockLocation?       @relation(fields: [assignedLocationId], references: [id], onDelete: SetNull)
  accounts                Account[]
  createdPurchaseOrders   PurchaseOrder[]      @relation("PurchaseOrderCreatedBy")
  approvedPurchaseOrders  PurchaseOrder[]      @relation("PurchaseOrderApprovedBy")
  createdSalesOrders      SalesOrder[]         @relation("SalesOrderCreatedBy")
  voidedSalesOrders       SalesOrder[]         @relation("SalesOrderVoidedBy")
  inventoryMovements      InventoryMovement[]
  auditLogs               AuditLog[]
  productCostHistory      ProductCostHistory[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Supplier {
  id             String            @id @default(uuid())
  name           String            @unique
  contactName    String?
  email          String?
  phone          String?
  address        String?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  productLinks   ProductSupplier[]
  purchaseOrders PurchaseOrder[]
}

model ProductSupplier {
  id           String   @id @default(uuid())
  productId    String
  supplierId   String
  isPrimary    Boolean  @default(false)
  costPrice    Decimal  @db.Decimal(12, 2)
  leadTimeDays Int?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@unique([productId, supplierId])
  @@index([supplierId])
}

model Product {
  id            String                @id @default(uuid())
  name          String
  sku           String                @unique
  description   String?
  unitPrice     Decimal               @db.Decimal(12, 2)
  costPrice     Decimal               @db.Decimal(12, 2)
  reorderLevel  Int                   @default(0)
  imageUrl      String?
  status        ProductStatus         @default(ACTIVE)
  categoryId    String
  brandId       String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  category      Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand         Brand?                @relation(fields: [brandId], references: [id], onDelete: SetNull)
  suppliers     ProductSupplier[]
  locationStock LocationStock[]
  locationCosts LocationProductCost[]
  costHistory   ProductCostHistory[]
  purchaseItems PurchaseOrderItem[]
  salesItems    SalesOrderItem[]
  movements     InventoryMovement[]

  @@index([name])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
}

model StockLocation {
  id            String                @id @default(uuid())
  name          String                @unique
  code          String                @unique
  type          LocationType
  address       String?
  managerName   String?
  contactNumber String?
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  assignedUsers User[]
  stock         LocationStock[]
  productCosts  LocationProductCost[]
  costHistory   ProductCostHistory[]
  salesOrders   SalesOrder[]         @relation("SalesOrderLocation")
  salesItems    SalesOrderItem[]
  movements     InventoryMovement[]
}

model LocationStock {
  id           String        @id @default(uuid())
  locationId   String
  productId    String
  quantity     Int           @default(0)
  reservedQty  Int           @default(0)
  reorderLevel Int?
  updatedAt    DateTime      @updatedAt
  location     StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([locationId, productId])
  @@index([productId])
}

model LocationProductCost {
  id                  String        @id @default(uuid())
  locationId          String
  productId           String
  avgUnitCost         Decimal       @db.Decimal(12, 2)
  lastInboundUnitCost Decimal?      @db.Decimal(12, 2)
  onHandQtySnapshot   Int           @default(0)
  updatedAt           DateTime      @updatedAt
  location            StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product             Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([locationId, productId])
  @@index([productId])
}

model ProductCostHistory {
  id              String        @id @default(uuid())
  locationId      String
  productId       String
  inboundQty      Int
  inboundUnitCost Decimal       @db.Decimal(12, 2)
  prevAvgUnitCost Decimal       @db.Decimal(12, 2)
  newAvgUnitCost  Decimal       @db.Decimal(12, 2)
  sourceType      String
  sourceId        String?
  changePct       Decimal?      @db.Decimal(7, 4)
  reason          String?
  changedById     String
  createdAt       DateTime      @default(now())
  location        StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  changedBy       User          @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([locationId, productId, createdAt])
  @@index([productId, createdAt])
  @@index([changedById, createdAt])
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  orderNumber  String              @unique
  supplierId   String
  status       PurchaseOrderStatus @default(DRAFT)
  totalAmount  Decimal             @db.Decimal(12, 2)
  expectedDate DateTime?
  notes        String?
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy    User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy   User?               @relation("PurchaseOrderApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  items        PurchaseOrderItem[]

  @@index([status])
  @@index([supplierId])
  @@index([createdById])
  @@index([approvedById])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  receivedQty     Int           @default(0)
  unitCost        Decimal       @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, productId])
}

model SalesOrder {
  id                String               @id @default(uuid())
  orderNumber       String               @unique
  customerName      String
  customerEmail     String?
  locationId        String?
  status            SalesOrderStatus     @default(DRAFT)
  totalAmount       Decimal              @db.Decimal(12, 2)
  paymentMode       PaymentMode?
  cashAmount        Decimal?             @db.Decimal(12, 2)
  onlineAmount      Decimal?             @db.Decimal(12, 2)
  notes             String?
  archivedAt        DateTime?
  voidReason        SalesOrderVoidReason?
  voidRemarks       String?
  voidDocumentation String?
  voidedAt          DateTime?
  createdById       String
  voidedById        String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  location          StockLocation?       @relation("SalesOrderLocation", fields: [locationId], references: [id], onDelete: SetNull)
  createdBy         User                 @relation("SalesOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy          User?                @relation("SalesOrderVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  items             SalesOrderItem[]

  @@index([status])
  @@index([locationId])
  @@index([createdById])
  @@index([voidedById])
  @@index([voidReason])
  @@index([archivedAt])
}

model SalesOrderItem {
  id              String        @id @default(uuid())
  salesOrderId    String
  productId       String
  locationId      String
  quantity        Int
  unitPrice       Decimal       @db.Decimal(12, 2)
  unitCostAtSale  Decimal       @default(0) @db.Decimal(12, 2)
  lineCogs        Decimal       @default(0) @db.Decimal(12, 2)
  lineGrossProfit Decimal       @default(0) @db.Decimal(12, 2)
  isEstimatedCost Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  salesOrder      SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  location        StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([locationId])
}

model InventoryMovement {
  id              String        @id @default(uuid())
  type            MovementType
  productId       String
  locationId      String
  quantityChange  Int
  transferGroupId String?
  referenceType   String?
  referenceId     String?
  notes           String?
  performedById   String
  createdAt       DateTime      @default(now())
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  location        StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  performedBy     User          @relation(fields: [performedById], references: [id], onDelete: Restrict)

  @@index([productId, locationId, createdAt])
  @@index([referenceType, referenceId])
  @@index([performedById])
  @@index([transferGroupId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  details   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entity, entityId])
  @@index([userId, createdAt])
}

model LoginRateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}
